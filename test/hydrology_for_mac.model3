          </Option>
          <Option value="Half Basin" type="QString" name="component_description"/>
          <Option value="32.18800813008136" type="double" name="component_height"/>
          <Option value="951.2276422764227" type="double" name="component_pos_x"/>
          <Option value="731.2277470493284" type="double" name="component_pos_y"/>
          <Option value="200" type="double" name="component_width"/>
          <Option type="invalid" name="default_value"/>
          <Option value="false" type="bool" name="mandatory"/>
          <Option value="Half Basin" type="QString" name="name"/>
          <Option value="half_basin" type="QString" name="output_name"/>
          <Option value="true" type="bool" name="outputs_collapsed"/>
          <Option value="true" type="bool" name="parameters_collapsed"/>
        </Option>
        <Option type="Map" name="Topographic index ln(a/tanb)">
          <Option value="grass:r.watershed_1" type="QString" name="child_id"/>
          <Option value="" type="QString" name="color"/>
          <Option type="Map" name="comment">
            <Option value="" type="QString" name="color"/>
            <Option value="L'indice topografico ln(a/tanβ) è un parametro fondamentale nell'idrologia, e indica la propensione di un punto del territorio a generare ruscellamento superficiale o ad essere saturo d'acqua. È chiamato più precisamente Topographic Wetness Index (TWI)&#xa;Cosa rappresentano i termini:&#xa;a = Area del bacino contribuente specifica (specific catchment area). È l'area totale a monte che drena verso quel punto, per unità di larghezza di contorno. Rappresenta il volume d'acqua che converge verso il punto.&#xa;*tanβ= Pendenza locale (tangente dell'angolo di pendio). Rappresenta la forza di drenaggio gravitazionale che allontana l'acqua dal punto.&#xa;*ln = Logaritmo naturale, usato per linearizzare la relazione.&#xa;Interpretazione fisica (cosa ti indica):&#xa;L'indice combina due forze opposte:&#xa;1.  La convergenza d'acqua (a): Più 'a' è grande, più acqua arriva al punto, aumentando la probabilità di saturazione.&#xa;2.  La capacità di drenaggio (tanβ): Più 'tanβ' è grande (pendenza ripida), più velocemente l'acqua defluisce, riducendo la saturazione.&#xa;&#xa;Quindi, un valore ALTO dell'indice ln(a/tanβ) indica:&#xa;- Condizioni di potenziale saturazione: Punti del paesaggio dove converge molta acqua da monte ('a' grande) su un versante piano ('tanβ'piccolo).&#xa;- Alta probabilità di generare ruscellamento superficiale (runoff): Quando il terreno è saturo, anche una piccola pioggia in più non può infiltrarsi e genera deflusso superficiale immediato.&#xa;-Zone di accumulo di umidità:Aree come fondivalle, concavità, piedi dei versanti.&#xa;&#xa;Un valore BASSO dell'indice indica:&#xa;- Condizioni secche: Posti su pendii ripidi ('tanβ' grande) o dorsali ('a' piccola), dove l'acqua defluisce rapidamente o non converge.&#xa;- Alta capacità di infiltrazione: Il suolo tende a rimanere non saturo.&#xa;&#xa;Applicazioni pratiche:&#xa;L'indice è usato per mappare:&#xa;1.  Zone soggette a saturazione e ristagno (aree umide, zone ripari).&#xa;2.  Aree sorgente di deflusso superficiale durante gli eventi piovosi.&#xa;3.  La variabilità spaziale dell'umidità del suolo in un bacino.&#xa;4.  La potenziale localizzazione di processi di erosione o movimenti di massa (frane da saturazione).&#xa;" type="QString" name="component_description"/>
            <Option value="348" type="double" name="component_height"/>
            <Option value="1432.0000000000005" type="double" name="component_pos_x"/>
            <Option value="1182.6666666666665" type="double" name="component_pos_y"/>
            <Option value="649.3333333333337" type="double" name="component_width"/>
            <Option value="true" type="bool" name="outputs_collapsed"/>
            <Option value="true" type="bool" name="parameters_collapsed"/>
          </Option>
          <Option value="Topographic index ln(a/tanb)" type="QString" name="component_description"/>
          <Option value="32.66666666666663" type="double" name="component_height"/>
          <Option value="943.2799796747967" type="double" name="component_pos_x"/>
